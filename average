import sys

data = []
number = ""

for line in sys.stdin:
    for x in line:
        if x == " " or x == "\n":
            if number != "":
                data.append(float(number))
                number = ""
        else:
            number += x

if number != "":
    data.append(float(number))

if len(data) == 0:
    print("error", file=sys.stderr)
    sys.exit(1)

total = 0
for x in data:
    total += x

average = total / len(data)

print("average:", average)
