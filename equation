import math
import sys


def num(s):
    if s == "" or s == "+":
        return 1.0
    if s == "-":
        return -1.0
    return float(s)


line = sys.stdin.read().strip()
if line == "" or "\n" in line:
    print("エラー: 形式が異なります", file=sys.stderr)
    sys.exit(1)

line = line.replace(" ", "")
q = line.split(",")
if len(q) != 2:
    print("エラー: 形式が異なります", file=sys.stderr)
    sys.exit(1)

m = []
for eq in q:
    if eq.count("=") != 1 or eq.count("x") != 1 or eq.count("y") != 1:
        print("エラー: 形式が異なります", file=sys.stderr)
        sys.exit(1)

    left, right = eq.split("=")
    if "x" not in left or "y" not in left:
        print("エラー: 形式が異なります", file=sys.stderr)
        sys.exit(1)

    a, rest = left.split("x")
    if "y" not in rest:
        print("エラー: 形式が異なります", file=sys.stderr)
        sys.exit(1)

    b, tail = rest.split("y")
    if tail != "":
        print("エラー: 形式が異なります", file=sys.stderr)
        sys.exit(1)

    if b == "" or (b[0] != "+" and b[0] != "-"):
        print("エラー: 形式が異なります", file=sys.stderr)
        sys.exit(1)

    try:
        a = num(a)
        b = num(b)
        c = float(right)
    except ValueError:
        print("エラー: 形式が異なります", file=sys.stderr)
        sys.exit(1)

    if not math.isfinite(a) or not math.isfinite(b) or not math.isfinite(c):
        print("エラー: 数値が不適切です", file=sys.stderr)
        sys.exit(1)

    m.append([a, b, c])

if m[0][0] == 0.0 or m[1][1] == 0.0:
    print("エラー: ０", file=sys.stderr)
    sys.exit(1)

x = 0.0
y = 0.0
max = 1000
n = 1e-6
OK = False

for k in range(max):
    newx = (m[0][2] - m[0][1] * y) / m[0][0]
    newy = (m[1][2] - m[1][0] * newx) / m[1][1]

    if not math.isfinite(newx) or not math.isfinite(newy):
        print("エラー: diverged", file=sys.stderr)
        sys.exit(1)

    if abs(newx - x) < n and abs(newy - y) < n:
        x = newx
        y = newy
        OK = True
        break

    x = newx
    y = newy

if not OK:
    print("エラー: 値が収束しません", file=sys.stderr)
    sys.exit(1)

print(f"{x:.6f}")
print(f"{y:.6f}")