import sys


def to_num(s):
    if s == "" or s == "+":
        return 1.0
    if s == "-":
        return -1.0
    return float(s)


line = sys.stdin.read().strip()
if line == "" or "\n" in line:
    print("error: invalid format", file=sys.stderr)
    sys.exit(1)

line = line.replace(" ", "")
eqs = line.split(",")
if len(eqs) != 2:
    print("error: invalid format", file=sys.stderr)
    sys.exit(1)

m = []
for eq in eqs:
    if eq.count("=") != 1 or eq.count("x") != 1 or eq.count("y") != 1:
        print("error: invalid format", file=sys.stderr)
        sys.exit(1)

    left, right = eq.split("=")
    if "x" not in left or "y" not in left:
        print("error: invalid format", file=sys.stderr)
        sys.exit(1)

    a_str, rest = left.split("x")
    if "y" not in rest:
        print("error: invalid format", file=sys.stderr)
        sys.exit(1)

    b_str, tail = rest.split("y")
    if tail != "":
        print("error: invalid format", file=sys.stderr)
        sys.exit(1)

    if b_str == "" or (b_str[0] != "+" and b_str[0] != "-"):
        print("error: invalid format", file=sys.stderr)
        sys.exit(1)

    try:
        a = to_num(a_str)
        b = to_num(b_str)
        c = float(right)
    except ValueError:
        print("error: invalid format", file=sys.stderr)
        sys.exit(1)

    m.append([a, b, c])

x = 0.0
y = 0.0
max_iter = 1000
eps = 1e-6

for k in range(max_iter):
    new_x = (m[0][2] - m[0][1] * y) / m[0][0]
    new_y = (m[1][2] - m[1][0] * new_x) / m[1][1]

    if abs(new_x - x) < eps and abs(new_y - y) < eps:
        x = new_x
        y = new_y
        break

    x = new_x
    y = new_y

print(f"{x:.6f}")
print(f"{y:.6f}")